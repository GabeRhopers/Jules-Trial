# Copy this file to .env (same folder) and paste your key after the = sign.
# .env is ignored by git, so your key never gets committed. Never paste keys into chat.

# ElevenLabs: Settings > API Keys at elevenlabs.io. Restrict the key: Text to Speech + User read, plus a credit quota.
# Free plan: run narration on your own computer (free tier is disabled behind proxies/VPNs).
ELEVENLABS_API_KEY=

# Optional: path to the Python that has Kokoro installed (default: .venv/bin/python)
# KOKORO_PYTHON=
